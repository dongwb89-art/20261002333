import turtle
import math

# =========================
# 创建窗口
# =========================
screen = turtle.Screen()
screen.setup(1000, 700)
screen.title("2P 坦克大战")
screen.bgcolor("lightgreen")
screen.tracer(0)

# =========================
# 创建坦克
# =========================
tank1 = turtle.Turtle()
tank1.shape("arrow")
tank1.color("blue")
tank1.shapesize(2, 2)
tank1.penup()
tank1.goto(-300, 0)
tank1.setheading(0)

tank2 = turtle.Turtle()
tank2.shape("arrow")
tank2.color("red")
tank2.shapesize(2, 2)
tank2.penup()
tank2.goto(300, 0)
tank2.setheading(180)

# =========================
# 按键状态
# =========================
keys = {
    "w": False,
    "a": False,
    "s": False,
    "d": False,
    "f": False,

    "up": False,
    "down": False,
    "left": False,
    "right": False,
    "k": False
}

# =========================
# 游戏状态
# =========================
game_over = False
bullets = []


# =========================
# 按键函数
# =========================
def press(key):
    keys[key] = True


def release(key):
    keys[key] = False


# =========================
# 1P 射击
# =========================
def shoot1():
    if game_over:
        return

    bullet = turtle.Turtle()
    bullet.shape("circle")
    bullet.color("blue")
    bullet.shapesize(0.5, 0.5)
    bullet.penup()

    angle = math.radians(tank1.heading())

    x = tank1.xcor() + math.cos(angle) * 30
    y = tank1.ycor() + math.sin(angle) * 30

    bullet.goto(x, y)
    bullet.setheading(tank1.heading())

    bullets.append([bullet, 1])


# =========================
# 2P 射击
# =========================
def shoot2():
    if game_over:
        return

    bullet = turtle.Turtle()
    bullet.shape("circle")
    bullet.color("red")
    bullet.shapesize(0.5, 0.5)
    bullet.penup()

    angle = math.radians(tank2.heading())

    x = tank2.xcor() + math.cos(angle) * 30
    y = tank2.ycor() + math.sin(angle) * 30

    bullet.goto(x, y)
    bullet.setheading(tank2.heading())

    bullets.append([bullet, 2])


# =========================
# 移动坦克
# =========================
def move_tanks():

    if game_over:
        return

    # ---------- 1P ----------

    if keys["a"]:
        tank1.left(4)

    if keys["d"]:
        tank1.right(4)

    speed1 = 0

    if keys["w"]:
        speed1 = 4

    if keys["s"]:
        speed1 = -3

    if keys["f"]:
        speed1 = 8

    tank1.forward(speed1)

    # ---------- 2P ----------

    if keys["left"]:
        tank2.left(4)

    if keys["right"]:
        tank2.right(4)

    speed2 = 0

    if keys["up"]:
        speed2 = 4

    if keys["down"]:
        speed2 = -3

    if keys["k"]:
        speed2 = 8

    tank2.forward(speed2)

    # ---------- 限制范围 ----------

    tank1.setx(max(-470, min(470, tank1.xcor())))
    tank1.sety(max(-320, min(320, tank1.ycor())))

    tank2.setx(max(-470, min(470, tank2.xcor())))
    tank2.sety(max(-320, min(320, tank2.ycor())))


# =========================
# 显示胜利
# =========================
writer = turtle.Turtle()
writer.hideturtle()
writer.penup()


def show_winner(text):

    writer.goto(0, 30)

    writer.write(
        text,
        align="center",
        font=("Arial", 40, "bold")
    )

    writer.goto(0, -30)

    writer.write(
        "按 R 重新开始",
        align="center",
        font=("Arial", 20, "normal")
    )


# =========================
# 子弹移动
# =========================
def move_bullets():

    global game_over

    for bullet_data in bullets[:]:

        bullet = bullet_data[0]
        owner = bullet_data[1]

        bullet.forward(12)

        # 出界
        if (
            bullet.xcor() > 500
            or bullet.xcor() < -500
            or bullet.ycor() > 350
            or bullet.ycor() < -350
        ):
            bullet.hideturtle()
            bullets.remove(bullet_data)
            continue

        # 1P 子弹击中 2P
        if owner == 1:

            if bullet.distance(tank2) < 30:

                game_over = True

                bullet.hideturtle()

                show_winner("1P 获胜！")

                return

        # 2P 子弹击中 1P
        if owner == 2:

            if bullet.distance(tank1) < 30:

                game_over = True

                bullet.hideturtle()

                show_winner("2P 获胜！")

                return


# =========================
# 重新开始
# =========================
def restart():

    global game_over

    game_over = False

    writer.clear()

    # 删除所有子弹
    for bullet_data in bullets:
        bullet_data[0].hideturtle()

    bullets.clear()

 
